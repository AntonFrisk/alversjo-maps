          {
            "datasource": {
              "type": "victoriametrics-metrics-datasource",
              "uid": "victoriametrics"
            },
            "editorMode": "code",
            "expr": "label_replace(last_over_time(Milesight_WS302_LCeq[1h]), \"Device\", \"$1\", \"dev_name\", \"Sound_(.+)\") * ${correction_factor}",
            "format": "time_series",
            "hide": false,
            "instant": true,
            "legendFormat": "Last Measured",
            "range": false,
            "refId": "A"
          },
          {
            "datasource": {
              "type": "victoriametrics-metrics-datasource",
              "uid": "victoriametrics"
            },
            "editorMode": "code",
            "expr": "median_over_time(Milesight_WS302_LCeq[6m]) * ${correction_factor}",
            "hide": false,
            "instant": true,
            "legendFormat": "Rolling Median",
            "range": false,
            "refId": "B"
          },
          {
            "datasource": {
              "type": "victoriametrics-metrics-datasource",
              "uid": "victoriametrics"
            },
