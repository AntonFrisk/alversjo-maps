            "legendFormat": "Allowed Max",
            "range": false,
            "refId": "C"
          },
          {
            "datasource": {
              "type": "victoriametrics-metrics-datasource",
              "uid": "victoriametrics"
            },
            "editorMode": "code",
            "expr": "(median_over_time(Milesight_WS302_LCeq[6m]) * ${correction_factor}) > bool on(label) group_left(zone,campname) sound_curfew_limit_dbc",
            "format": "time_series",
            "hide": false,
            "instant": true,
            "legendFormat": "Status",
            "range": false,
            "refId": "D"
          }
        ],
        "title": "Sound camp overview ",
        "transformations": [
          {
            "id": "labelsToFields",
            "options": {
              "keepLabels": [
                "label",
                "Device",
                "zone",
                "campname"
              ],
              "mode": "columns"
            }
          },
          {
            "id": "merge",
            "options": {}
          },
          {
            "id": "calculateField",
            "options": {
              "alias": "Difference",
              "binary": {
                "left": "Rolling Median",
                "operator": "-",
                "right": "Allowed Max"
              },
              "mode": "binary",
              "replaceFields": false
            }
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "__name__": true,
                "dev_name": true,
                "label": false
              },
              "indexByName": {
                "Allowed Max": 6,
                "Campname": 2,
                "Device": 0,
                "Difference": 7,
                "Label": 1,
                "Last Measured": 4,
                "Rolling Median": 5,
                "Status": 8,
                "Zone": 3
              },
              "renameByName": {
                "campname": "Campname",
                "label": "Label",
                "zone": "Zone"
              }
            }
          }
        ],
        "type": "table"
