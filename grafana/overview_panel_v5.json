  "transformations": [
    {
      "id": "timeSeriesTable",
      "options": {
        "E": {
          "stat": "lastNotNull"
        }
      }
    },
    {
      "id": "merge",
      "options": {}
    },
    {
      "id": "convertFieldType",
      "options": {
        "conversions": [
          {
            "targetField": "max_dbc_now",
            "destinationType": "number"
          },
          {
            "targetField": "dbc_diff_abs",
            "destinationType": "number"
          }
        ],
        "fields": {}
      }
    },
    {
      "id": "calculateField",
      "options": {
        "mode": "binary",
        "binary": {
          "left": "Value #C",
          "operator": "+",
          "right": "dbc_diff_abs"
        },
        "alias": "LCmax_r3m",
        "replaceFields": false
      }
    },
    {
      "id": "calculateField",
      "options": {
        "mode": "binary",
        "binary": {
          "left": "Value #B",
          "operator": "+",
          "right": "dbc_diff_abs"
        },
        "alias": "LCeq",
        "replaceFields": false
      }
    },
    {
      "id": "calculateField",
      "options": {
        "mode": "binary",
        "binary": {
          "left": "LCmax_r3m",
          "operator": "-",
          "right": "max_dbc_now"
        },
        "alias": "status",
        "replaceFields": false
      }
    },
    {
      "id": "filterFieldsByName",
      "options": {
        "include": {
          "names": [
            "device_id",
            "Campname",
            "zone",
            "tier",
            "LCmax_r3m",
            "max_dbc_now",
            "status",
            "Value #D",
            "Trend #E"
          ]
        }
      }
    },
    {
      "id": "organize",
      "options": {
        "excludeByName": {},
        "indexByName": {
          "device_id": 0,
          "Campname": 1,
          "zone": 2,
          "tier": 3,
          "LCmax_r3m": 4,
          "max_dbc_now": 5,
          "status": 6,
          "Trend #E": 7,
          "Value #D": 8
        },
        "renameByName": {
          "device_id": "id",
          "Campname": "campname",
          "max_dbc_now": "max_dbc",
          "Trend #E": "LCmax trend",
          "Value #D": "ts_updated"
        }
      }
    }
