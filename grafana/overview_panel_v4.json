{
  "id": 19,
  "type": "table",
  "title": "Sound camp overview + sensor metadata (v4)",
  "description": "Per-camp overview: id and campname come from the published Google Sheet 'sensors' CSV (Infinity), joined on device_id with VictoriaMetrics sound metrics. LCmax trend is a sparkline of LCmax (sensor_sound_LCImax) over the panel time range; ts_updated is the absolute timestamp of the last sample. LCmax/LCeq/LCmax_r3m (median over 3m) are still computed but hidden. All dB values include the ${correction_factor} calibration factor.",
  "gridPos": {
    "x": 0,
    "y": 0,
    "h": 30,
    "w": 24
  },
  "fieldConfig": {
    "defaults": {
      "custom": {
        "align": "left",
        "cellOptions": {
          "type": "auto"
        },
        "inspect": false,
        "filterable": true
      },
      "mappings": [],
      "thresholds": {
        "mode": "absolute",
        "steps": [
          {
            "color": "green",
            "value": null
          },
          {
            "color": "red",
            "value": 80
          }
        ]
      },
      "color": {
        "mode": "thresholds"
      },
      "unit": "dB"
    },
    "overrides": [
      {
        "matcher": {
          "id": "byName",
          "options": "id"
        },
        "properties": [
          {
            "id": "unit",
            "value": "short"
          },
          {
            "id": "custom.cellOptions",
            "value": {
              "type": "auto"
            }
          },
          {
            "id": "color",
            "value": {
              "mode": "fixed",
              "fixedColor": "text"
            }
          }
        ]
      },
      {
        "matcher": {
          "id": "byName",
          "options": "campname"
        },
        "properties": [
          {
            "id": "unit",
            "value": "short"
          },
          {
            "id": "custom.cellOptions",
            "value": {
              "type": "auto"
            }
          },
          {
            "id": "color",
            "value": {
              "mode": "fixed",
              "fixedColor": "text"
            }
          }
        ]
      },
      {
        "matcher": {
          "id": "byName",
          "options": "tier"
        },
        "properties": [
          {
            "id": "unit",
            "value": "none"
          },
          {
            "id": "custom.cellOptions",
            "value": {
              "type": "auto"
            }
          },
          {
            "id": "color",
            "value": {
              "mode": "fixed",
              "fixedColor": "text"
            }
          }
        ]
      },
      {
        "matcher": {
          "id": "byName",
          "options": "LCmax_r3m"
        },
        "properties": [
          {
            "id": "unit",
            "value": "dB"
          },
          {
            "id": "custom.cellOptions",
            "value": {
              "type": "color-text"
            }
          }
        ]
      },
      {
        "matcher": {
          "id": "byName",
          "options": "ts_updated"
        },
        "properties": [
          {
            "id": "unit",
            "value": "time:YYMMDD HH:mm:ss"
          },
          {
            "id": "custom.cellOptions",
            "value": {
              "type": "color-text"
            }
          },
          {
            "id": "color",
            "value": {
              "mode": "fixed",
              "fixedColor": "text"
            }
          }
        ]
      },
      {
        "matcher": {
          "id": "byName",
          "options": "LCmax trend"
        },
        "properties": [
          {
            "id": "unit",
            "value": "dB"
          },
          {
            "id": "custom.cellOptions",
            "value": {
              "type": "sparkline"
            }
          },
          {
            "id": "color",
            "value": {
              "mode": "fixed",
              "fixedColor": "green"
            }
          },
          {
            "id": "custom.width",
            "value": 240
          }
        ]
      }
    ]
  },
  "transformations": [
    {
      "id": "timeSeriesTable",
      "options": {
        "E": {
          "stat": "lastNotNull"
        }
      }
    },
    {
      "id": "merge",
      "options": {}
    },
    {
      "id": "filterFieldsByName",
      "options": {
        "include": {
          "names": [
            "device_id",
            "Campname",
            "tier",
            "Value #C",
            "Value #D",
            "Trend #E"
          ]
        }
      }
    },
    {
      "id": "organize",
      "options": {
        "excludeByName": {},
        "indexByName": {
          "device_id": 0,
          "Campname": 1,
          "tier": 2,
          "Value #C": 3,
          "Trend #E": 4,
          "Value #D": 5
        },
        "renameByName": {
          "device_id": "id",
          "Campname": "campname",
          "Value #C": "LCmax_r3m",
          "Trend #E": "LCmax trend",
          "Value #D": "ts_updated"
        }
      }
    }
  ],
  "pluginVersion": "12.0.0",
  "targets": [
    {
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "editorMode": "code",
      "expr": "last_over_time(sensor_sound_LCImax[1h]) * ${correction_factor}",
      "format": "table",
      "hide": false,
      "instant": true,
      "legendFormat": "LCmax",
      "range": false,
      "refId": "A"
    },
    {
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "editorMode": "code",
      "expr": "last_over_time(sensor_sound_LCeq[1h]) * ${correction_factor}",
      "format": "table",
      "hide": false,
      "instant": true,
      "legendFormat": "LCeq",
      "range": false,
      "refId": "B"
    },
    {
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "editorMode": "code",
      "expr": "median_over_time(sensor_sound_LCImax[3m]) * ${correction_factor}",
      "format": "table",
      "hide": false,
      "instant": true,
      "legendFormat": "LCmax_r3m",
      "range": false,
      "refId": "C"
    },
    {
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "editorMode": "code",
      "expr": "tlast_over_time(sensor_sound_LCImax[6h]) * 1000",
      "format": "table",
      "hide": false,
      "instant": true,
      "legendFormat": "ts_updated",
      "range": false,
      "refId": "D"
    },
    {
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "editorMode": "code",
      "expr": "sensor_sound_LCImax * ${correction_factor}",
      "format": "time_series",
      "hide": false,
      "instant": false,
      "legendFormat": "LCmax trend",
      "range": true,
      "refId": "E"
    },
    {
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "ce19flpfolkowa"
      },
      "refId": "F",
      "type": "csv",
      "source": "url",
      "format": "table",
      "url": "https://docs.google.com/spreadsheets/d/e/2PACX-1vScZYHeWCrTqEvRE-x7Wkq2GvtzqYte7xM14M9yPipOeLzpX80kgGE0sqZlkzPEogQvZHjEKZccad7u/pub?gid=1709736396&single=true&output=csv",
      "url_options": {
        "method": "GET",
        "data": ""
      },
      "root_selector": "",
      "columns": [],
      "filters": [],
      "global_query_id": "",
      "parser": "backend"
    }
  ],
  "datasource": {
    "type": "datasource",
    "uid": "-- Mixed --"
  },
  "options": {
    "showHeader": true,
    "cellHeight": "md",
    "footer": {
      "show": false,
      "reducer": [
        "sum"
      ],
      "countRows": false,
      "fields": ""
    },
    "frameIndex": 0,
    "sortBy": [
      {
        "desc": false,
        "displayName": "campname"
      }
    ]
  }
}
