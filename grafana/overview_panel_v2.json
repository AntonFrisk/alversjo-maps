{
    "id": 100,
    "type": "table",
    "title": "Sound camp overview (v2)",
    "description": "Per-camp sound overview. LCmax and LCeq are the last measured values; LCmax_r3m is the rolling mean of LCmax over the last 3 minutes; ts_updated is the timestamp of the last received sample; LCeq trend is a sparkline of LCeq over the panel time range. All dB values include the ${correction_factor} calibration factor.",
    "gridPos": {
      "x": 0,
      "y": 0,
      "h": 30,
      "w": 24
    },
    "fieldConfig": {
      "defaults": {
        "custom": {
          "align": "left",
          "cellOptions": {
            "type": "auto"
          },
          "inspect": false,
          "filterable": true
        },
        "mappings": [],
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "color": "green",
              "value": null
            },
            {
              "color": "red",
              "value": 80
            }
          ]
        },
        "color": {
          "mode": "thresholds"
        },
        "unit": "dB"
      },
      "overrides": [
        {
          "matcher": {
            "id": "byName",
            "options": "id"
          },
          "properties": [
            {
              "id": "unit",
              "value": "short"
            },
            {
              "id": "custom.cellOptions",
              "value": {
                "type": "auto"
              }
            },
            {
              "id": "color",
              "value": {
                "mode": "fixed",
                "fixedColor": "text"
              }
            }
          ]
        },
        {
          "matcher": {
            "id": "byName",
            "options": "label"
          },
          "properties": [
            {
              "id": "unit",
              "value": "short"
            },
            {
              "id": "custom.cellOptions",
              "value": {
                "type": "auto"
              }
            },
            {
              "id": "color",
              "value": {
                "mode": "fixed",
                "fixedColor": "text"
              }
            }
          ]
        },
        {
          "matcher": {
            "id": "byName",
            "options": "LCmax"
          },
          "properties": [
            {
              "id": "unit",
              "value": "dB"
            },
            {
              "id": "custom.cellOptions",
              "value": {
                "type": "color-text"
              }
            }
          ]
        },
        {
          "matcher": {
            "id": "byName",
            "options": "LCeq"
          },
          "properties": [
            {
              "id": "unit",
              "value": "dB"
            },
            {
              "id": "custom.cellOptions",
              "value": {
                "type": "color-text"
              }
            }
          ]
        },
        {
          "matcher": {
            "id": "byName",
            "options": "LCmax_r3m"
          },
          "properties": [
            {
              "id": "unit",
              "value": "dB"
            },
            {
              "id": "custom.cellOptions",
              "value": {
                "type": "color-text"
              }
            }
          ]
        },
        {
          "matcher": {
            "id": "byName",
            "options": "ts_updated"
          },
          "properties": [
            {
              "id": "unit",
              "value": "dateTimeFromNow"
            },
            {
              "id": "custom.cellOptions",
              "value": {
                "type": "color-text"
              }
            },
            {
              "id": "color",
              "value": {
                "mode": "fixed",
                "fixedColor": "text"
              }
            }
          ]
        },
        {
          "matcher": {
            "id": "byName",
            "options": "LCeq trend"
          },
          "properties": [
            {
              "id": "unit",
              "value": "dB"
            },
            {
              "id": "custom.cellOptions",
              "value": {
                "type": "sparkline"
              }
            },
            {
              "id": "color",
              "value": {
                "mode": "fixed",
                "fixedColor": "green"
              }
            },
            {
              "id": "custom.width",
              "value": 240
            }
          ]
        }
      ]
    },
    "transformations": [
      {
        "id": "timeSeriesTable",
        "options": {
          "E": {
            "stat": "lastNotNull"
          }
        }
      },
      {
        "id": "merge",
        "options": {}
      },
      {
        "id": "organize",
        "options": {
          "excludeByName": {
            "Time": true,
            "__name__": true,
            "dev_name": true,
            "device_stream": true,
            "stream_id": true
          },
          "indexByName": {
            "device_id": 0,
            "label": 1,
            "Value #A": 2,
            "Value #B": 3,
            "Value #C": 4,
            "Value #D": 5,
            "Trend #E": 6
          },
          "renameByName": {
            "device_id": "id",
            "Value #A": "LCmax",
            "Value #B": "LCeq",
            "Value #C": "LCmax_r3m",
            "Value #D": "ts_updated",
            "Trend #E": "LCeq trend"
          }
        }
      }
    ],
    "pluginVersion": "12.0.0",
    "targets": [
      {
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "editorMode": "code",
        "expr": "last_over_time(sensor_sound_LCImax[1h]) * ${correction_factor}",
        "format": "table",
        "hide": false,
        "instant": true,
        "legendFormat": "LCmax",
        "range": false,
        "refId": "A"
      },
      {
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "editorMode": "code",
        "expr": "last_over_time(sensor_sound_LCeq[1h]) * ${correction_factor}",
        "format": "table",
        "hide": false,
        "instant": true,
        "legendFormat": "LCeq",
        "range": false,
        "refId": "B"
      },
      {
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "editorMode": "code",
        "expr": "avg_over_time(sensor_sound_LCImax[3m]) * ${correction_factor}",
        "format": "table",
        "hide": false,
        "instant": true,
        "legendFormat": "LCmax_r3m",
        "range": false,
        "refId": "C"
      },
      {
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "editorMode": "code",
        "expr": "timestamp(last_over_time(sensor_sound_LCImax[1h])) * 1000",
        "format": "table",
        "hide": false,
        "instant": true,
        "legendFormat": "ts_updated",
        "range": false,
        "refId": "D"
      },
      {
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "editorMode": "code",
        "expr": "sensor_sound_LCeq * ${correction_factor}",
        "format": "time_series",
        "hide": false,
        "instant": false,
        "legendFormat": "LCeq trend",
        "range": true,
        "refId": "E"
      }
    ],
    "datasource": {
      "type": "victoriametrics-metrics-datasource",
      "uid": "victoriametrics"
    },
    "options": {
      "showHeader": true,
      "cellHeight": "md",
      "footer": {
        "show": false,
        "reducer": [
          "sum"
        ],
        "countRows": false,
        "fields": ""
      },
      "frameIndex": 0,
      "sortBy": [
        {
          "desc": false,
          "displayName": "label"
        }
      ]
    }
  }